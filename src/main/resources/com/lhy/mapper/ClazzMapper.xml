<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lhy.mapper.ClazzMapper">
    <insert id="add">
      insert into Clazz (name,room,begin_date,end_date,master_id,create_time,update_time,subject) values (#{name},#{room},#{beginDate},#{endDate},#{masterId},#{createTime},#{updateTime},#{subject})
    </insert>
    <update id="putclazz">
        update Clazz
        <set>
        <if test="name != null">
            name = #{name},
        </if>
        <if test="room != null">
            room = #{room},
        </if>
        <if test="beginDate != null">
            begin_date = #{beginDate},
        </if>
        <if test="endDate != null">
            end_date = #{endDate},
        </if>
        <if test="masterId != null">
            master_id = #{masterId},
        </if>
        <if test="subject != null">
            subject = #{subject},
        </if>
        <if test="updateTime != null">
            update_time = #{updateTime},
        </if>
        </set>
        where id = #{id}
    </update>
    <delete id="deleteClazz">
        delete from Clazz where id = #{id}
    </delete>
    <select id="list" resultType="com.lhy.pojo.Clazz">
        Select c.id,c.name,c.room,c.begin_date,c.end_date,c.master_id,e.name master_name,subject,c.create_time,c.update_time
        from Clazz c left join  emp e
        on c.master_id = e.id
    <where>
        <if test="name != null">
             c.name like CONCAT('%', #{name}, '%')
        </if>
        <if test="begin != null and end != null">
            and c.end_date between #{begin} and #{end}
        </if>
    </where>
    </select>
    <select id="queryClazzById" resultType="com.lhy.pojo.Clazz">
        Select c.id,c.name,c.room,c.begin_date,c.end_date,c.master_id,subject,c.create_time,c.update_time
        from Clazz c
        where c.id = #{id}
    </select>
    <select id="queryClazzList" resultType="com.lhy.pojo.Clazz">
        Select c.id,c.name,c.room,c.begin_date,c.end_date,c.master_id,subject,c.create_time,c.update_time
        from Clazz c
    </select>
</mapper>